# -- coding: utf-8 --
"""
Model za predikciju kašnjenja letova
-----------------------------------

Što dobivate:
- Robustan pipeline (Scikit‑learn) za klasifikaciju kašnjenja (> THRESHOLD_MINUTES min)
- Feature engineering (cikličke varijable, pomoćne binarne značajke)
- One-Hot kodiranje kategorija + numeričke značajke
- Dvije obitelji modela: LogisticRegression i HistGradientBoostingClassifier
- RandomizedSearchCV za poboljšanje performansi
- Kalibracija vjerojatnosti (Isotonic)
- Tuning praga na validacijskom skupu (maksimizacija F1)
- Evaluacija: Accuracy, Balanced Accuracy, Precision, Recall, F1, ROC AUC, PR AUC, Brier
- Grafovi: ROC, PR, krivulja kalibracije, matrica zabune
- Permutacijska važnost značajki (na pripremljenom test skupu)
- Spremanje najboljeg modela i praga

Kako pokrenuti:
1) Postavite PATH_CSV na vašu datoteku (npr. "flights_main.csv").
2) Osigurajte da stupci iz BASE_FEATURES postoje: ['carrier','month','day','day_of_week','hour','distance','flight_num','arr_delay_time']
3) python model_predikcije_kasnjenja_letova.py

Napomene:
- THRESHOLD_MINUTES = 15 (usklađeno s DOT definicijom kašnjenja). Možete promijeniti u 0 ako želite svaku pozitivnu minutu kao kašnjenje.
- Split je stratificiran i slučajan (20% test). Za rad s vremenskom validacijom, zamijenite random split TimeSeriesSplit procedurom.
"""

import json
import math
import warnings
from dataclasses import dataclass
from typing import Dict, Tuple

import numpy as np
import pandas as pd
from joblib import dump

from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.compose import ColumnTransformer, make_column_selector
from sklearn.calibration import CalibratedClassifierCV, CalibrationDisplay
from sklearn.inspection import permutation_importance
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score,
    balanced_accuracy_score,
    brier_score_loss,
    classification_report,
    confusion_matrix,
    f1_score,
    precision_recall_curve,
    precision_score,
    recall_score,
    roc_auc_score,
    roc_curve,
)
from sklearn.model_selection import RandomizedSearchCV, train_test_split
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.ensemble import HistGradientBoostingClassifier
from scipy.stats import randint, loguniform, uniform
import matplotlib.pyplot as plt

warnings.filterwarnings("ignore", category=UserWarning)

# =========================
# Konfiguracija
# =========================
PATH_CSV = "flights_main.csv"  # <- promijenite po potrebi
RANDOM_STATE = 42
TEST_SIZE = 0.20
THRESHOLD_MINUTES = 15  # prag za definiranje kašnjenja
N_ITER_SEARCH = 25      # broj uzoraka u RandomizedSearchCV
CV_FOLDS = 5

BASE_FEATURES = [
    "carrier", "month", "day", "day_of_week", "hour", "distance", "flight_num",
]
TARGET_COL = "arr_delay_time"  # u minutama (pozitivno = kasni)

# =========================
# Pomoćni transformeri
# =========================
class AddFeatures(BaseEstimator, TransformerMixin):
    """Dodaje cikličke i pomoćne značajke. Radi nad pandas DataFrame-om."""
    def _init_(self, hour_col="hour", month_col="month", dow_col="day_of_week"):
        self.hour_col = hour_col
        self.month_col = month_col
        self.dow_col = dow_col

    def fit(self, X, y=None):
        return self

    def transform(self, X):
        X = X.copy()
        # Osiguraj tipove
        for c in [self.hour_col, self.month_col, self.dow_col, "day", "distance", "flight_num"]:
            if c in X.columns:
                X[c] = pd.to_numeric(X[c], errors="coerce")
        if "carrier" in X.columns:
            X["carrier"] = X["carrier"].astype("category")
        if self.dow_col in X.columns:
            X[self.dow_col] = X[self.dow_col].astype("category")

        # Cikličke kodifikacije
        if self.hour_col in X.columns:
            X["hour_sin"] = np.sin(2 * np.pi * (X[self.hour_col] % 24) / 24)
            X["hour_cos"] = np.cos(2 * np.pi * (X[self.hour_col] % 24) / 24)
        if self.month_col in X.columns:
            X["month_sin"] = np.sin(2 * np.pi * ((X[self.month_col] - 1) % 12) / 12)
            X["month_cos"] = np.cos(2 * np.pi * ((X[self.month_col] - 1) % 12) / 12)

        # Dodatne korisne binarne značajke
        if self.dow_col in X.columns:
            # Pretpostavka: 1=Pon ... 7=Ned (ako je 0-6, i to je ok)
            dow_num = pd.to_numeric(X[self.dow_col].astype(str).str.extract(r"(\d+)").fillna(0)[0], errors="coerce").fillna(0).astype(int)
            X["is_weekend"] = ((dow_num % 7) >= 6).astype(int)
        if self.hour_col in X.columns:
            X["is_peak_hour"] = X[self.hour_col].between(6, 9).astype(int) | X[self.hour_col].between(16, 19).astype(int)

        # Lagana normalizacija distance (log)
        if "distance" in X.columns:
            X["distance_log1p"] = np.log1p(X["distance"].clip(lower=0))

        return X


def make_preprocessor():
    # Selektori po tipu nakon AddFeatures
    cat_selector = make_column_selector(dtype_include=["category", "object"])
    num_selector = make_column_selector(dtype_include=np.number)

    pre = ColumnTransformer(
        transformers=[
            ("cat", OneHotEncoder(handle_unknown="ignore", sparse_output=False), cat_selector),
            ("num", "passthrough", num_selector),
        ],
        remainder="drop",
        verbose_feature_names_out=False,
    )
    return pre


@dataclass
class ModelAndName:
    name: str
    pipe: Pipeline


def build_pipelines(random_state: int) -> Tuple[ModelAndName, ModelAndName]:
    pre = make_preprocessor()

    logreg = Pipeline([
        ("feat", AddFeatures()),
        ("prep", pre),
        ("model", LogisticRegression(
            solver="saga", max_iter=2000, n_jobs=-1, class_weight="balanced", penalty="l2", C=1.0,
            random_state=random_state,
        )),
    ])

    hgb = Pipeline([
        ("feat", AddFeatures()),
        ("prep", pre),
        ("model", HistGradientBoostingClassifier(
            random_state=random_state, class_weight="balanced",
        )),
    ])

    return (
        ModelAndName("LogisticRegression", logreg),
        ModelAndName("HistGradientBoosting", hgb),
    )


def search_spaces():
    logreg_space = {
        "model__C": loguniform(1e-2, 50),
    }
    hgb_space = {
        "model__learning_rate": loguniform(0.01, 0.3),
        "model__max_depth": randint(3, 11),
        "model__max_leaf_nodes": randint(15, 255),
        "model__min_samples_leaf": randint(10, 200),
        "model__l2_regularization": loguniform(1e-4, 10),
        "model__max_bins": randint(64, 255),
    }
    return logreg_space, hgb_space


def fit_with_search(model_and_name: ModelAndName, X_train: pd.DataFrame, y_train: pd.Series,
                    n_iter=N_ITER_SEARCH, cv_folds=CV_FOLDS, random_state=RANDOM_STATE) -> RandomizedSearchCV:
    logreg_space, hgb_space = search_spaces()
    space = logreg_space if model_and_name.name.startswith("Logistic") else hgb_space
    search = RandomizedSearchCV(
        estimator=model_and_name.pipe,
        param_distributions=space,
        n_iter=n_iter,
        scoring="average_precision",  # PR AUC, bolje za neuravnotežene skupove
        cv=cv_folds,
        verbose=1,
        n_jobs=-1,
        random_state=random_state,
        refit=True,
    )
    search.fit(X_train, y_train)
    return search


def choose_threshold(y_true: np.ndarray, proba: np.ndarray, beta: float = 1.0) -> Tuple[float, Dict[str, float]]:
    """Odaberi prag koji maksimizira F-beta na validaciji."""
    precision, recall, th = precision_recall_curve(y_true, proba)
    # Izračun F-beta (bez zadnjeg elementa jer PR vraća N+1 točku)
    fbeta = (1 + beta*2) * (precision[:-1] * recall[:-1]) / (beta*2 * precision[:-1] + recall[:-1] + 1e-12)
    idx = int(np.nanargmax(fbeta))
    best_threshold = float(th[idx])
    return best_threshold, {
        "precision": float(precision[idx]),
        "recall": float(recall[idx]),
        "fbeta": float(fbeta[idx]),
    }


def evaluate_at_threshold(y_true, proba, threshold: float) -> Dict[str, float]:
    pred = (proba >= threshold).astype(int)
    return {
        "accuracy": accuracy_score(y_true, pred),
        "balanced_accuracy": balanced_accuracy_score(y_true, pred),
        "precision": precision_score(y_true, pred, zero_division=0),
        "recall": recall_score(y_true, pred, zero_division=0),
        "f1": f1_score(y_true, pred, zero_division=0),
        "roc_auc": roc_auc_score(y_true, proba),
        "pr_auc": average_precision_score_safe(y_true, proba),
        "brier": brier_score_loss(y_true, proba),
    }


def average_precision_score_safe(y_true, proba):
    # Lokalna implementacija da izbjegnemo dodatne uvoze ako treba
    from sklearn.metrics import average_precision_score
    return average_precision_score(y_true, proba)


def plot_roc(y_true, proba, title: str):
    fpr, tpr, _ = roc_curve(y_true, proba)
    auc = roc_auc_score(y_true, proba)
    plt.figure(figsize=(6, 5))
    plt.plot(fpr, tpr, label=f"ROC AUC = {auc:.3f}")
    plt.plot([0, 1], [0, 1], linestyle="--")
    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")
    plt.title(title)
    plt.legend()
    plt.tight_layout()
    plt.show()


def plot_pr(y_true, proba, title: str):
    precision, recall, _ = precision_recall_curve(y_true, proba)
    ap = average_precision_score_safe(y_true, proba)
    plt.figure(figsize=(6, 5))
    plt.plot(recall, precision, label=f"AP = {ap:.3f}")
    plt.xlabel("Recall")
    plt.ylabel("Precision")
    plt.title(title)
    plt.legend()
    plt.tight_layout()
    plt.show()


def plot_confusion(y_true, pred, title: str):
    from sklearn.metrics import ConfusionMatrixDisplay
    cm = confusion_matrix(y_true, pred)
    disp = ConfusionMatrixDisplay(cm, display_labels=["Na vrijeme", "Kasnio"])
    plt.figure(figsize=(5, 5))
    disp.plot(values_format="d")
    plt.title(title)
    plt.tight_layout()
    plt.show()


def plot_calibration(y_true, proba, title: str):
    CalibrationDisplay.from_predictions(y_true, proba, n_bins=10)
    plt.title(title)
    plt.tight_layout()
    plt.show()


def show_permutation_importance(fitted_pipeline: Pipeline, X_test: pd.DataFrame, y_test: pd.Series, top_n: int = 20):
    r = permutation_importance(fitted_pipeline, X_test, y_test, n_repeats=5, random_state=RANDOM_STATE, n_jobs=-1)
    importances = pd.DataFrame({
        "feature": np.array(fitted_pipeline.named_steps["prep"].get_feature_names_out()),
        "importance_mean": r.importances_mean,
        "importance_std": r.importances_std,
    }).sort_values("importance_mean", ascending=False).head(top_n)
    print("\nTop značajke prema permutacijskoj važnosti:")
    print(importances.to_string(index=False))

    plt.figure(figsize=(8, 6))
    plt.barh(importances["feature"][::-1], importances["importance_mean"][::-1])
    plt.xlabel("Permutacijska važnost (srednja vrijednost)")
    plt.title("Najvažnije značajke")
    plt.tight_layout()
    plt.show()


# =========================
# Glavni tijek
# =========================
if _name_ == "_main_":
    # 1) Učitavanje i priprema
    df = pd.read_csv(PATH_CSV)

    missing_cols = [c for c in BASE_FEATURES + [TARGET_COL] if c not in df.columns]
    if missing_cols:
        raise ValueError(f"Nedostaju stupci u CSV-u: {missing_cols}")

    # Target: 1 = kasnio (> THRESHOLD_MINUTES)
    df["delay_cls"] = (pd.to_numeric(df[TARGET_COL], errors="coerce") > THRESHOLD_MINUTES).astype(int)
    y = df["delay_cls"].astype(int)
    X = df[BASE_FEATURES].copy()

    print("Distribucija klase (1=kasnio):")
    print(y.value_counts(normalize=True).rename({0:"na_vrijeme",1:"kasnio"}).round(3))

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=TEST_SIZE, random_state=RANDOM_STATE, stratify=y
    )

    # 2) Modeli + pretraga hiperparametara
    logreg_model, hgb_model = build_pipelines(RANDOM_STATE)

    print("\n>>> Tuning: LogisticRegression")
    rs_log = fit_with_search(logreg_model, X_train, y_train)
    print(f"Najbolji score (AP): {rs_log.best_score_:.4f}")

    print("\n>>> Tuning: HistGradientBoosting")
    rs_hgb = fit_with_search(hgb_model, X_train, y_train)
    print(f"Najbolji score (AP): {rs_hgb.best_score_:.4f}")

    # 3) Odabir boljeg modela prema AP
    best_search = rs_hgb if rs_hgb.best_score_ >= rs_log.best_score_ else rs_log
    best_name = "HGB" if best_search is rs_hgb else "LogReg"
    best_model = best_search.best_estimator_

    print(f"\n>>> Odabrani model: {best_name} ({best_search.best_score_:.4f} AP na CV)")

    # 4) Kalibracija vjerojatnosti (na train skupu, s internim CV)
    calibrated = CalibratedClassifierCV(best_model, method="isotonic", cv=3)
    calibrated.fit(X_train, y_train)

    # 5) Odabir praga na malom validacijskom izdvojenom dijelu od train-a
    X_tr, X_val, y_tr, y_val = train_test_split(
        X_train, y_train, test_size=0.2, random_state=RANDOM_STATE, stratify=y_train
    )
    calibrated.fit(X_tr, y_tr)
    val_proba = calibrated.predict_proba(X_val)[:, 1]
    best_threshold, val_stats = choose_threshold(y_val.values, val_proba, beta=1.0)

    print(f"\n>>> Odabrani prag (na validaciji): {best_threshold:.3f}")
    print(f"Precision={val_stats['precision']:.3f} Recall={val_stats['recall']:.3f} F1={val_stats['fbeta']:.3f}")

    # 6) Konačna evaluacija na test skupu
    calibrated.fit(X_train, y_train)
    test_proba = calibrated.predict_proba(X_test)[:, 1]
    test_pred = (test_proba >= best_threshold).astype(int)

    metrics = evaluate_at_threshold(y_test, test_proba, best_threshold)
    print("\n=== METRIKE (TEST) ===")
    for k, v in metrics.items():
        print(f"{k}: {v:.4f}")

    print("\n=== Classification report (TEST) ===")
    print(classification_report(y_test, test_pred, target_names=["na_vrijeme", "kasnio"]))

    # 7) Grafovi
    plot_roc(y_test, test_proba, f"ROC krivulja ({best_name})")
    plot_pr(y_test, test_proba, f"PR krivulja ({best_name})")
    plot_calibration(y_test, test_proba, f"Kalibracija ({best_name})")
    plot_confusion(y_test, test_pred, f"Matrica zabune ({best_name})")

    # 8) Permutacijska važnost značajki
    show_permutation_importance(calibrated, X_test, y_test, top_n=20)

    # 9) Spremanje modela i praga
    dump(calibrated, "best_flight_delay_model.joblib")
    with open("best_threshold.json", "w", encoding="utf-8") as f:
        json.dump({"threshold": best_threshold, "note": "Prag odabran maksimizacijom F1 na validaciji."}, f, ensure_ascii=False, indent=2)

    print("\nArtefakti spremljeni: best_flight_delay_model.joblib, best_threshold.json")
